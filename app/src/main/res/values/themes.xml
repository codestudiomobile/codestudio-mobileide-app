<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        ===== CODE STUDIO – "Code Studio Mobile IDE" One Dark Theme =====
        Root theme for the entire app. Uses AppCompat (not Material3) so that
        overflow/popup menus render with the correct dark background and white text.
        colorPrimary / colorPrimaryDark / colorAccent match the original Code Studio Mobile IDE app.
    -->
    <style name="Theme.CodeStudio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Code Studio Mobile IDE primary palette -->
        <item name="colorPrimary">@color/cc_primary_dark</item>
        <item name="colorPrimaryDark">@color/cc_primary_dark</item>
        <item name="colorAccent">@color/cc_accent</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/cc_primary_dark</item>
        <item name="android:colorBackground">@color/cc_primary_dark</item>

        <!-- Status / nav bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/cc_primary_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/cc_primary_dark</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/grey_400</item>
        <item name="android:textColorLink">@color/cc_accent</item>
        <item name="android:textAllCaps">false</item>

        <!-- ActionBar / Toolbar -->
        <item name="actionBarStyle">@style/CodeStudio.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionBarPopupTheme">@style/CodeStudio.PopupMenu</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Popup / overflow menus -->
        <item name="popupMenuStyle">@style/CodeStudio.PopupMenu</item>
        <item name="popupTheme">@style/CodeStudio.PopupMenu</item>
        <item name="android:dropDownListViewStyle">@style/CodeStudio.DropDownList</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/CodeStudio.AlertDialog</item>

        <!-- Font (JetBrains Mono applied globally) -->
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>

        <!-- Extra Keys Bar Colors -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/white</item>
        <item name="extraKeysButtonBackgroundColor">@android:color/transparent</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/extra_keys_active_bg</item>
    </style>

    <style name="SubTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFCCCCCC</item>
    </style>

    <style name="CodeStudio.TabTextStyle" parent="android:TextAppearance">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
    </style>

    <!-- NoActionBar variant – used where we provide a custom Toolbar -->
    <style name="Theme.CodeStudio.NoActionBar" parent="Theme.CodeStudio">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ──────────────────────────────────────────── -->
    <!--  ActionBar                                   -->
    <!-- ──────────────────────────────────────────── -->
    <style name="CodeStudio.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/cc_primary</item>
        <item name="titleTextStyle">@style/CodeStudio.ActionBar.TitleText</item>
        <item name="subtitleTextStyle">@style/CodeStudio.ActionBar.SubtitleText</item>
        <item name="popupTheme">@style/CodeStudio.PopupMenu</item>
    </style>

    <style name="CodeStudio.ActionBar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/ide_text_primary</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
    </style>

    <style name="CodeStudio.ActionBar.SubtitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/ide_text_secondary</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
    </style>

    <!-- ──────────────────────────────────────────── -->
    <!--  Popup / overflow menus  (THE CRITICAL FIX)  -->
    <!--  Dark background + white text = visible menu  -->
    <!-- ──────────────────────────────────────────── -->
    <style name="CodeStudio.PopupMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/cc_primary</item>
        <item name="android:textColorPrimary">@color/ide_text_primary</item>
        <item name="android:textColor">@color/ide_text_primary</item>
        <item name="overlapAnchor">true</item>
    </style>

    <style name="CodeStudio.DropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@color/cc_primary</item>
    </style>

    <!-- ──────────────────────────────────────────── -->
    <!--  Alert Dialogs                               -->
    <!-- ──────────────────────────────────────────── -->
    <style name="CodeStudio.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/cc_accent</item>
        <item name="android:colorBackground">@color/cc_primary</item>
        <item name="android:textColorPrimary">@color/ide_text_primary</item>
        <item name="android:textColorSecondary">@color/ide_text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/CodeStudio.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/CodeStudio.Dialog.Button</item>
    </style>

    <style name="CodeStudio.Dialog.Button" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/cc_accent</item>
    </style>

    <!-- ──────────────────────────────────────────── -->
    <!--  Termux Activity (black background)          -->
    <!-- ──────────────────────────────────────────── -->
    <!-- Keep Termux internal theme untouched -->
    <style name="Theme.BaseActivity.Light.DarkActionBar" parent="Theme.CodeStudio">
        <item name="colorPrimary">@color/ide_toolbar</item>
        <item name="colorPrimaryDark">@color/ide_background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ide_toolbar</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
    </style>

    <style name="Theme.BaseActivity.Light.NoActionBar" parent="Theme.BaseActivity.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar" />

    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar" />

    <style name="Theme.MediaViewActivity.Light" parent="Theme.BaseActivity.Light.NoActionBar" />

    <style name="Theme.MarkdownViewActivity.Light" parent="Theme.MediaViewActivity.Light" />

    <style name="Theme.MediaViewActivity.DayNight" parent="Theme.BaseActivity.DayNight.NoActionBar" />

    <style name="Theme.MarkdownViewActivity.DayNight" parent="Theme.MediaViewActivity.DayNight" />

    <style name="ThemeOverlay.BaseDialog.Light" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/cc_accent</item>
        <item name="android:colorBackground">@color/cc_primary</item>
        <item name="android:textColorPrimary">@color/ide_text_primary</item>
    </style>

    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.BaseDialog.Light" />

    <style name="ThemeOverlay.MessageDialog.DayNight" parent="ThemeOverlay.BaseDialog.DayNight" />

    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar" />

    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar" />

    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar" />

    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar" />

    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <item name="termuxActivityDrawerBackground">@color/white</item>
        <item name="termuxActivityDrawerImageTint">@color/black</item>
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/white</item>
        <item name="extraKeysButtonBackgroundColor">@android:color/transparent</item>
        <item name="extraKeysButtonActiveBackgroundColor">#2D2D2D</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
    </style>

</resources>
