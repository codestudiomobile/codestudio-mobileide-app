<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manageLanguagesLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_primary_dark"
    android:orientation="vertical"
    tools:context="com.csmide.app.activities.ManageLanguagesActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cc_primary_dark"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/CodeStudio.PopupMenu.Theme"
        app:title="@string/title_manage_languages"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/settingName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/title_manage_languages"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@color/cc_primary"
        android:drawableStart="@android:drawable/ic_search_category_default"
        android:drawableTint="@color/grey_400"
        android:hint="@string/hint_search_language_packs"
        android:inputType="textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/grey_400" />

    <ListView
        android:id="@+id/packagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/cc_primary"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/progressStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/msg_installing_package"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/installProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cc_accent" />

        <TextView
            android:id="@+id/extractStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Installation Progress"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/extractProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="#4CAF50"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
